+        match &result {
+            Ok(n) if *n > 0 && *n < buf.len() => self.drained = true,
+            Err(e) if e.kind() == io::ErrorKind::WouldBlock => {
+                self.state.lock().readable = false;
+            }
+            _ => {}
         }
         result
     }
