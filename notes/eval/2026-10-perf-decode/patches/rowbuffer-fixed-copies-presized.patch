+#[inline(always)]
+fn copy_cell(data: &mut Vec<u8>, bytes: &[u8]) {
+    match bytes.len() {
+        1 => data.push(bytes[0]),
+        4 => copy_fixed::<4>(data, bytes),
+        8 => copy_fixed::<8>(data, bytes),
+        16 => copy_fixed::<16>(data, bytes),
+        _ => data.extend_from_slice(bytes),
+    }
