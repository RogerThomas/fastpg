# Reproducible Linux build + test of fastpg against the compose PostgreSQL.
# Usage: docker compose --profile test run --rm --build tests   (or: task test-docker)
# uv installs the exact Python pinned in .python-version (same as local development).
FROM debian:trixie-slim
# Same uv as local development (the floating distro-tagged uv images lag behind).
COPY --from=ghcr.io/astral-sh/uv:0.12.24 /uv /uvx /usr/local/bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates build-essential \
    && rm -rf /var/lib/apt/lists/*
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}" \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=automatic

WORKDIR /src
COPY . .
RUN uv sync --locked --all-groups

# cargo test links libpython; point the loader at uv's interpreter.
CMD ["sh", "-c", "PY=$(uv python find) && export PYO3_PYTHON=$PY LD_LIBRARY_PATH=$($PY -c 'import sysconfig; print(sysconfig.get_config_var(\"LIBDIR\"))') && cargo test --manifest-path native/Cargo.toml -q && uv run --no-sync pytest -q"]
